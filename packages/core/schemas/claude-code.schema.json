{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-doctor.local/schemas/claude-code.schema.json",
  "title": "Claude Code MCP config",
  "description": "Project file .mcp.json. Remote entries need type plus url. ${VAR} and ${VAR:-default} expand in command, args, env, url, and headers. Shape documented at https://code.claude.com/docs/en/mcp. Field meaning is enforced by mcp-doctor's lints; this schema checks types.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "mcpServers": {
      "type": "object",
      "description": "Server map for Claude Code.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "url": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeout": {
            "type": "number"
          },
          "type": {
            "enum": [
              "stdio",
              "http",
              "sse",
              "ws",
              "streamable-http"
            ]
          }
        }
      }
    }
  }
}
