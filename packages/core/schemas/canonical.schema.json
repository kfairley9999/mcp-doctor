{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-doctor.local/schemas/canonical.schema.json",
  "title": "mcp-doctor canonical config",
  "description": "mcp-doctor's interchange document. Every field the other clients can express has a home here.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "servers"
  ],
  "properties": {
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name",
          "transport"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "transport": {
            "enum": [
              "stdio",
              "http",
              "sse",
              "ws"
            ]
          },
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "envFile": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "type": "number"
          },
          "disabled": {
            "type": "boolean"
          },
          "autoApprove": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trust": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "extensions": {
            "type": "object"
          }
        }
      }
    }
  }
}
