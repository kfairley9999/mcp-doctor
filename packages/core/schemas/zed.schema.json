{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-doctor.local/schemas/zed.schema.json",
  "title": "Zed MCP config",
  "description": "Lives inside settings.json under context_servers, not mcpServers. command is a string. A remote server is a url. Zed does not document variable expansion. Shape documented at https://zed.dev/docs/ai/mcp. Field meaning is enforced by mcp-doctor's lints; this schema checks types.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "context_servers": {
      "type": "object",
      "description": "Server map for Zed.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "url": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          }
        }
      }
    }
  }
}
