    "text": "{\n  \"mcpServers\": {\n    \"shared-server\": {\n      \"type\": \"http\",\n      \"url\": \"https://example.com/mcp\"\n    }\n  }\n}\n"
  },
  {
    "id": "claude-code-stdio",
    "client": "claude-code",
    "doc": "https://code.claude.com/docs/en/agent-sdk/mcp",
    "text": "{\n  \"mcpServers\": {\n    \"filesystem\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"@modelcontextprotocol/server-filesystem\", \"/Users/me/projects\"]\n    }\n  }\n}\n"
  },
  {
    "id": "claude-code-expansion",
    "client": "claude-code",
    "doc": "https://code.claude.com/docs/en/mcp",
    "text": "{\n  \"mcpServers\": {\n    \"api-server\": {\n      \"type\": \"http\",\n      \"url\": \"${API_BASE_URL:-https://api.example.com}/mcp\",\n      \"headers\": {\n        \"Authorization\": \"Bearer ${API_KEY}\"\n      }\n    }\n  }\n}\n"
  },
  {
    "id": "cursor-stdio",
    "client": "cursor",
    "doc": "https://cursor.com/docs/mcp",
    "text": "{\n  \"mcpServers\": {\n    \"server-name\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"mcp-server\"],\n      \"env\": {\n        \"API_KEY\": \"${env:API_KEY}\"\n      }\n    }\n  }\n}\n"
  },
  {
    "id": "cursor-remote",
    "client": "cursor",
    "doc": "https://cursor.com/docs/mcp",
    "text": "{\n  \"mcpServers\": {\n    \"server-name\": {\n      \"url\": \"http://localhost:3000/mcp\",\n      \"headers\": {\n        \"API_KEY\": \"value\"\n      }\n    }\n  }\n}\n"
  },
  {
    "id": "vscode-mixed",
    "client": "vscode",
    "doc": "https://code.visualstudio.com/docs/agents/reference/mcp-configuration",
    "text": "{\n  \"inputs\": [\n    {\n      \"type\": \"promptString\",\n      \"id\": \"api-key\",\n      \"description\": \"API key\",\n      \"password\": true\n    }\n  ],\n  \"servers\": {\n    \"local\": {\n      \"type\": \"stdio\",\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"my-mcp\"],\n      \"env\": {\n        \"API_KEY\": \"${input:api-key}\"\n      }\n    },\n    \"remote\": {\n      \"type\": \"http\",\n      \"url\": \"https://example.com/mcp\",\n      \"headers\": {\n        \"Authorization\": \"Bearer ${input:api-key}\"\n      }\n    }\n  }\n}\n"
  },
  {
    "id": "windsurf-github",
    "client": "windsurf",
    "doc": "https://docs.devin.ai/windsurf/plugins/cascade/mcp",
    "text": "{\n  \"mcpServers\": {\n    \"github\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"@modelcontextprotocol/server-github\"],\n      \"env\": {\n        \"GITHUB_PERSONAL_ACCESS_TOKEN\": \"<YOUR_PERSONAL_ACCESS_TOKEN>\"\n      }\n    }\n  }\n}\n"
  },
  {
    "id": "windsurf-remote",
    "client": "windsurf",
    "doc": "https://docs.devin.ai/windsurf/plugins/cascade/mcp",
    "text": "{\n  \"mcpServers\": {\n    \"remote-http-mcp\": {\n      \"serverUrl\": \"https://example.com/mcp\",\n      \"headers\": {\n        \"API_KEY\": \"Bearer ${env:AUTH_TOKEN}\"\n      }\n    }\n  }\n}\n"
  },
  {
    "id": "cline-stdio",
    "client": "cline",
    "doc": "https://github.com/cline/cline/blob/main/docs/mcp/mcp-overview.mdx",
    "text": "{\n  \"mcpServers\": {\n    \"local-server\": {\n      \"command\": \"node\",\n      \"args\": [\"/path/to/server.js\"],\n      \"env\": {\n        \"API_KEY\": \"your_api_key\"\n      },\n      \"disabled\": false,\n      \"autoApprove\": []\n    }\n  }\n}\n"
  },
  {
    "id": "cline-http",
    "client": "cline",
    "doc": "https://github.com/cline/cline/blob/main/docs/mcp/mcp-overview.mdx",
    "text": "{\n  \"mcpServers\": {\n    \"remote-server\": {\n      \"type\": \"streamableHttp\",\n      \"url\": \"https://example.com/mcp\",\n      \"headers\": {\n        \"Authorization\": \"Bearer your-token\"\n      },\n      \"disabled\": false,\n      \"autoApprove\": []\n    }\n  }\n}\n"
  },
  {
