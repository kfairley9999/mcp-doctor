  {
    "id": "gemini-stdio",
    "client": "gemini-cli",
    "doc": "https://geminicli.com/docs/tools/mcp-server/",
    "text": "{\n  \"mcpServers\": {\n    \"serverName\": {\n      \"command\": \"path/to/server\",\n      \"args\": [\"--arg1\", \"value1\"],\n      \"env\": {\n        \"API_KEY\": \"$MY_API_TOKEN\"\n      },\n      \"cwd\": \"./server-directory\",\n      \"timeout\": 30000,\n      \"trust\": false\n    }\n  }\n}\n"
  },
  {
    "id": "gemini-http",
