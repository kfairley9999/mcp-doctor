{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mcp-doctor-playground",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-18",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
}
